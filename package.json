{
  "name": "pollen-ui",
  "version": "5.0.0",
  "private": true,
  "license": "MIT",
  "description": "React components for Next.js with a design language that behaves, a React Native sibling kit, shared tokens, and the docs site.",
  "author": "Pankaj Israni <https://github.com/1-Pankaj>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1-Pankaj/pollen-ui.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "generate": "node scripts/generate-docs-data.mjs",
    "prebuild": "npm run generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:lib": "npm run build --workspace pollen-ui",
    "typecheck": "tsc --noEmit",
    "typecheck:lib": "npm run typecheck --workspace pollen-ui",
    "screenshots": "node scripts/screenshot.mjs",
    "check:tokens": "node scripts/check-tokens-sync.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.1",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "tsup": "^9.0.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
